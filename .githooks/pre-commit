#!/usr/bin/env bash
# Spotless, crapper, and dryer on staged Java. Mutation stays in CI.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

staged=()
while IFS= read -r file; do
  [[ -z "$file" ]] && continue
  staged+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [[ ${#staged[@]} -eq 0 ]]; then
  exit 0
fi

stashed=0
cleanup() {
  status=$?
  if [[ "$stashed" -eq 1 ]]; then
    git stash pop --quiet || echo "pre-commit: git stash pop failed; look in git stash" >&2
  fi
  exit "$status"
}

trap cleanup EXIT

if ! git diff --quiet || [[ -n "$(git ls-files --others --exclude-standard)" ]]; then
  git stash push --keep-index --include-untracked --quiet
  stashed=1
fi

java=()
for file in "${staged[@]}"; do
  case "$file" in
    *.java)
      java+=("$file")
      ;;
  esac
done

if [[ ${#java[@]} -gt 0 ]]; then
  mvn -B -ntp spotless:check

  scripts/quality/check-quality.sh --staged
fi
